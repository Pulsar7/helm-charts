{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "strategy": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "additionalVolumes": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array"},
    "initContainers": {"type": "array"},

    

    "librefrontierConfig": {
      "type": "object",
      "properties": {
        "ginMode": {"type": "string", "enum": ["release", "debug"]},
        "LFAPIBaseURL": {"type": "string"},
        "databaseConnectionString": {
          "type": "object",
          "properties": {
            "secretName": {"type": "string"},
            "existingSecret": {"type": "boolean"},
            "stringData": {"type": "string"}
          }
        }
      }
    },

    "httpAPIIngressRoute": {
        "type": "object",
        "properties": {
            "enabled": {"type": "boolean"},
            "entryPoints": {"type": "array"},
            "host": {"type": "string"}
        }
    },
    "webUIIngressRoute": {
        "type": "object",
        "properties": {
            "enabled": {"type": "boolean"},
            "entryPoints": {"type": "array"},
            "certResolver": {"type": "string"},
            "host": {"type": "string"}
        }
    }
  },

  "required": [
    "replicaCount",
    "initContainers",
    "containers",
    "httpAPIIngressRoute",
    "webUIIngressRoute"
  ],

  "title": "Values",
  "type": "object"
}
