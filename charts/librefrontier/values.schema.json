{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "strategy": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "additionalVolumes": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array"},
    "initContainers": {"type": "array"},
    "extraContainers": {"type": "array"},
    
    "librefrontierContainer": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": {"type": "string"},
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "pullPolicy": {"type": "string"}
          }
        },
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "ports": {
          "type": "object",
          "properties": {
            "http": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "containerPort": {"type": "integer"}
              }
            }
          }
        },
        "extraVolumeMounts": {"type": "array"},
        "extraEnv": {"type": "array"},
        "extraArgs": {"type": "array"},
        "startupProbe": {"type": "object"},
        "readinessProbe": {"type": "object"},
        "livenessProbe": {"type": "object"}
      }
    },

    "services": {
      "type": "object",
      "properties": {
        "httpAPI": {
          "type": "object",
          "properties": {
            "serviceName": {"type": "string"},
            "type": {"type": "string"},
            "ports": {
              "type": "object",
              "properties": {
                "httpAPI": {
                  "type": "object",
                  "properties": {
                    "servicePortName": {"type": "string"},
                    "portNumber": {"type": "integer"},
                    "targetPort": {"type": "string"},
                    "protocol": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "httpWebUI": {
          "type": "object",
          "properties": {
            "serviceName": {"type": "string"},
            "type": {"type": "string"},
            "ports": {
              "type": "object",
              "properties": {
                "httpAPI": {
                  "type": "object",
                  "properties": {
                    "servicePortName": {"type": "string"},
                    "portNumber": {"type": "integer"},
                    "targetPort": {"type": "string"},
                    "protocol": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },

    "ingressRoutes": {
      "type": "object",
      "properties": {
        "httpAPI": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "name": {"type": "string"},
            "refServiceName": {"type": "string"},
            "entryPoints": {"type": "array"},
            "routeMatch": {"type": "string"},
            "certResolver": {"type": "string"},
            "refMiddlewares": {"type": "array"}
          }
        }
      }
    },

    "middlewares": {"type": "object"},

    "config": {
      "type": "object",
      "properties": {
        "ginMode": {"type": "string", "enum": ["release", "debug"]},
        "lfAPIBaseURL": {"type": "string"},
        "databaseConnectionString": {
          "type": "object",
          "properties": {
            "secretName": {"type": "string"},
            "existingSecret": {"type": "boolean"},
            "stringData": {"type": "string"}
          }
        }
      }
    }
  },

  "required": [
    "replicaCount",
    "initContainers",
    "extraContainers",
    "librefrontierContainer",
    "config"
  ],

  "title": "Values",
  "type": "object"
}
