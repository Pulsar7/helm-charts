{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "strategy": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array"},
    "extraVolumes": {"type": "array"},

    "extraInitContainers": {"type": "array"},
    "extraContainers": {"type": "array"},

    "ntfyContainer": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
           "registry": {"type": "string"},
           "repository": {"type": "string"},
           "tag": {"type": "string"},
           "pullPolicy": {"type": "string"}
          }
        },
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "service": {
          "type": "object",
          "properties": {
            "serviceName": {"type": "string"},
            "type": {"type": "string"},
            "ports": {"type": "array"}
          }
        },
        "extraVolumeMounts": {"type": "array"},
        "extraEnvs": {"type": "array"},
        "extraArgs": {"type": "array"},
        "startupProbe": {"type": "object"},
        "readinessProbe": {"type": "object"},
        "livenessProbe": {"type": "object"}
      }
    },

    "authentication": {
      "type": "object",
      "properties": {
        "authTokens": {
          "type": "object",
          "properties": {
            "useExistingSecret": {"type": "boolean"},
            "secretName": {"type": "string"},
            "secretKey": {"type": "string"},
            "defaultSecretValue": {"type": "string"}
          }
        },
        "authUsers": {
          "type": "object",
          "properties": {
            "useExistingSecret": {"type": "boolean"},
            "secretName": {"type": "string"},
            "secretKey": {"type": "string"},
            "defaultSecretValue": {"type": "string"}
          }
        },
        "authAccess": {
          "type": "object",
          "properties": {
            "useExistingSecret": {"type": "boolean"},
            "secretName": {"type": "string"},
            "secretKey": {"type": "string"},
            "defaultSecretValue": {"type": "string"}
          }
        }
      }
    },

    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "emptyDir": {"type": "object"},
        "persistentVolumeClaim": {
          "type": "object",
          "properties": {
            "useExistingPVC": {"type": "boolean"},
            "storageClassName": {"type": "string"},
            "claimName": {"type": "string"},
            "accessModes": {"type": "array"},
            "storageRequest": {"type": "string"},
            "extraSpecs": {"type": "object"}
          }
        }
      }
    },

    "serverConfig": {
      "type": "object",
      "properties": {
        "useExistingConfigMap": {"type": "boolean"},
        "configMapName": {"type": "string"},
        "configMapItemKey": {"type": "string"},
        "dynamicValues": {
          "type": "object",
          "properties": {
            "extraConfig": {"type": "string"},
            "behindProxy": {"type": "boolean"},
            "proxyForwardedHeader": {"type": "string"},
            "baseURL": {"type": "string"},
            "attachments": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "cacheDir": {"type": "string"},
                "totalSizeLimit": {"type": "string"},
                "fileSizeLimit": {"type": "string"},
                "emptyDuration": {"type": "string"}
              }
            },
            "rateLimits": {
              "type": "object",
              "properties": {
                "visitorSubscriberRateLimiting": {"type": "boolean"},
                "messageSizeLimit": {"type": "string"},
                "messageDelayLimit": {"type": "string"},
                "globalTopicLimit": {"type": "integer", "minimum": 0},
                "visitorSubscriptionLimit": {"type": "integer", "minimum": 0},
                "visitorRequestLimitBurst": {"type": "integer", "minItems": 0},
                "visitorRequestLimitReplenish": {"type": "string"},
                "visitorRequestLimitExemptHosts": {"type": "string"},
                "visitorMessageDailyLimit": {"type": "integer", "minimum": 0},
                "visitorAttachmentTotalSizeLimit": {"type": "string"},
                "visitorAttachmentDailyBandwidthLimit": {"type": "string"}
              }
            },
            "authFile": {"type": "string"},
            "authDefaultAccess": {"type": "string"},
            "authUsers": {"type": "array"},
            "authAccess": {"type": "array"},
            "authTokens": {"type": "array"},
            "cacheFile": {"type": "string"},
            "cacheDuration": {"type": "string"},
            "cacheBatchSize": {"type": "integer", "minimum": 0},
            "cacheBatchTimeout": {"type": "string"},
            "cacheStartupQueries": {"type": "string"},
            "managerInterval": {"type": "string"},
            "disallowedTopics": {"type": "array"},
            "webRoot": {"type": "string"},
            "enableSignup": {"type": "boolean"},
            "requireLogin": {"type": "boolean"},
            "enableLogin": {"type": "boolean"},
            "enableReservations": {"type": "boolean"},
            "enableMetrics": {"type": "boolean"},
            "logLevel": {"type": "string"},
            "logLevelOverrides": {"type": "array"},
            "logFormat": {"type": "string"},
            "logFile": {"type": "string"}
          }
        }
      }
    }
  },

  "required": [
    "replicaCount",
    "strategy"
  ],

  "title": "Values",
  "type": "object"
}