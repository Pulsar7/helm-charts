{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "strategy": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "extraVolumes": {"type": "array"},
    "nodeSelector": {"type": "object"},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array"},

    "radicaleContainer": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "pullPolicy": {"type": "string"}
          }
        },
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "service": {
          "type": "object",
          "properties": {
            "type": {"type": "string"},
            "ports": {"type": "array"}
          }
        },
        "extraVolumeMounts": {"type": "array"},
        "environmentVariables": {"type": "array"},
        "livenessProbe": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "initialDelaySeconds": {"type": "integer"},
            "periodSeconds": {"type": "integer"},
            "timeoutSeconds": {"type": "integer"},
            "failureThreshold": {"type": "integer"},
            "successThreshold": {"type": "integer"}
          }
        },
        "readinessProbe": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "initialDelaySeconds": {"type": "integer"},
            "periodSeconds": {"type": "integer"},
            "timeoutSeconds": {"type": "integer"},
            "failureThreshold": {"type": "integer"},
            "successThreshold": {"type": "integer"}
          }
        }
      }
    },

    "authentication": {
      "type": "object",
      "properties": {
        "useExistingSecret": {"type": "boolean"},
        "secretName": {"type": "string"},
        "secretKey": {"type": "string"}
      }
    },

    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "emptyDirSizeLimit": {"type": "string"},
        "createPVC": {"type": "boolean"},
        "storageClassName": {"type": "string"},
        "claimName": {"type": "string"},
        "accessModes": {"type": "array"},
        "storageRequest": {"type": "string"}
      }
    },

    "configFile": {
      "type": "object",
      "properties": {
        "useExistingConfigMap": {"type": "boolean"},
        "configMapName": {"type": "string"},
        "configMapKey": {"type": "string"},
        "dynamicValues": {
          "type": "object",
          "properties": {
            "serverSection": {"type": "string"},
            "authSection": {"type": "string"},
            "rightsSection": {"type": "string"},
            "storageSection": {"type": "string"},
            "webSection": {"type": "string"},
            "loggingSection": {"type": "string"}
          }
        }
      }
    },

    "ingressRoute": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "entryPoints": {"type": "array"},
        "certResolver": {"type": "string"},
        "routeMatch": {"type": "string"}
      }
    },
    "middlewares": {"type": "array"}
  },

  "required": [
    "replicaCount",
    "strategy",
    "radicaleContainer",
    "authentication",
    "persistence",
    "configFile",
    "middlewares"
  ],

  "title": "Values",
  "type": "object"
}
