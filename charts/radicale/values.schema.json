{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "strategy": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "extraVolumes": {"type": "array"},
    "nodeSelector": {"type": "object"},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array"},

    "radicaleContainer": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "pullPolicy": {"type": "string"}
          }
        },
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "httpPort": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "containerPort": {"type": "integer", "minimum": 0}
          }
        },
        "extraPorts": {"type": "object"},
        "extraVolumeMounts": {"type": "array"},
        "env": {"type": "array"},
        "startupProbe": {"type": "object"},
        "readinessProbe": {"type": "object"},
        "livenessProbe": {"type": "object"}
      }
    },

    "httpService": {
      "type": "object",
      "properties": {
        "serviceName": {"type": "string"},
        "type": {"type": "string"},
        "additionalSpecs": {"type": "object"},
        "httpPort": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "portNumber": {"type": "integer", "minimum": 0},
            "protocol": {"type": "string"}
          }
        }
      }
    },
    "extraServices": {"type": "object"},

    "httpIngressRoute": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "entryPoints": {"type": "array"},
        "certResolver": {"type": "string"},
        "routeMatch": {"type": "string"},
        "refMiddlewares": {"type": "array"}
      }
    },
    "extraIngressRoutes": {"type": "object"},
    "middlewares": {"type": "object"},

    "authentication": {
      "type": "object",
      "properties": {
        "useExistingSecret": {"type": "boolean"},
        "secretName": {"type": "string"},
        "secretKey": {"type": "string"}
      }
    },

    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "emptyDirSizeLimit": {"type": "string"},
        "createPVC": {"type": "boolean"},
        "storageClassName": {"type": "string"},
        "claimName": {"type": "string"},
        "accessModes": {"type": "array"},
        "storageRequest": {"type": "string"}
      }
    },

    "configFile": {
      "type": "object",
      "properties": {
        "useExistingConfigMap": {"type": "boolean"},
        "configMapName": {"type": "string"},
        "configMapKey": {"type": "string"},
        "dynamicValues": {
          "type": "object",
          "properties": {
            "extraServerSection": {"type": "string"},
            "authSection": {"type": "string"},
            "rightsSection": {"type": "string"},
            "storageSection": {"type": "string"},
            "webSection": {"type": "string"},
            "loggingSection": {"type": "string"}
          }
        }
      }
    }
  },

  "required": [
    "replicaCount",
    "strategy",
    "radicaleContainer",
    "httpService",
    "httpIngressRoute",
    "authentication",
    "persistence",
    "configFile"
  ],

  "title": "Values",
  "type": "object"
}
